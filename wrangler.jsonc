{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "task-manager",
  "compatibility_date": "2026-07-03",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-manager-db",
      "database_id": "dd542bec-8e0a-4932-b0b9-784abf489ce4",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Brute-force protection for login / OAuth consent: 10 attempts per minute per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    // MCP endpoint + OAuth token/registration: 120 requests per minute per IP.
    { "name": "MCP_LIMITER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    // JWT_SECRET and INVITE_CODE are set as SECRETS for production
    // (wrangler secret put JWT_SECRET). For local dev they live in .dev.vars.
  }
}
