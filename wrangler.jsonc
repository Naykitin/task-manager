{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "task-manager",
  "compatibility_date": "2026-07-03",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-manager-db",
      // Replace with the database_id printed by `wrangler d1 create task-manager-db`
      // (see README "Deploy to Cloudflare").
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // JWT_SECRET and INVITE_CODE are set as SECRETS for production
    // (wrangler secret put JWT_SECRET). For local dev they live in .dev.vars.
  }
}
